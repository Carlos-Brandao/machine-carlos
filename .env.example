# Telegram: token do @BotFather e IDs autorizados a controlar o bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Backend que controla a fila e os robôs. Não inclua barra no fim.
# Pode ficar vazio temporariamente para testar /iniciar e o multiselect.
BACKEND_API_URL=
BACKEND_API_TOKEN=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# BACKEND_DATABASE_PATH=/root/ROBO_FACIL/backend.sqlite3

# Credenciais e convênios dos robôs continuam abaixo, seguindo o padrão atual.
# Exemplo:
# SAFECONSIG_CONVENIOS=fortaleza,tamboril
# SAFECONSIG_FORTALEZA_URL_LOGIN=
# SAFECONSIG_FORTALEZA_USUARIO=
# SAFECONSIG_FORTALEZA_SENHA=

# Comando executado pelo scheduler para cada prefeitura. Deixe vazio enquanto
# a credencial, URL ou base ainda não estiver disponível: o job ficará na fila.
# ROBOT_COMMAND_FORTALEZA="/root/ROBO_FACIL/env/bin/python main.py safeconsig fortaleza --file data/fortaleza.xlsx -y"
# ROBOT_COMMAND_TAMBORIL="/root/ROBO_FACIL/env/bin/python main.py safeconsig tamboril --file data/tamboril.xlsx -y"
