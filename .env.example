# Telegram: token do @BotFather e IDs autorizados a controlar o bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Destino das notificações automáticas dos robôs. O controlador e as
# notificações usam o mesmo TELEGRAM_BOT_TOKEN.
TELEGRAM_NOTIFICATION_CHAT_ID=

# Backend que controla a fila e os robôs. Não inclua barra no fim.
# Pode ficar vazio temporariamente para testar /iniciar e o multiselect.
BACKEND_API_URL=
BACKEND_API_TOKEN=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
WORKER_API_URL=http://127.0.0.1:8000
WORKER_API_TOKEN=
# Obrigatório para backend e scheduler. SQLite é usado somente nos testes.
DATABASE_URL=postgresql://machine:SENHA_FORTE@127.0.0.1:5432/machine

# Painel administrativo e criptografia. Gere valores novos; nunca reutilize
# tokens de Telegram, 2Captcha ou senhas de portais nestas chaves.
ADMIN_SESSION_SECRET=
APP_MASTER_KEY=
ADMIN_COOKIE_SECURE=true
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
MACHINE_STORAGE_DIR=/root/ROBO_FACIL/storage
MAX_UPLOAD_BYTES=26214400

# Usados uma única vez para criar o primeiro administrador. Remova ambos do
# ambiente depois que o login for criado com sucesso.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Credenciais e convênios dos robôs continuam abaixo, seguindo o padrão atual.
# Exemplo:
# SAFECONSIG_CONVENIOS=fortaleza,maranguape
# SAFECONSIG_FORTALEZA_URL_LOGIN=
# SAFECONSIG_FORTALEZA_USUARIO=
# SAFECONSIG_FORTALEZA_SENHA=
# RF1_CONVENIOS=boa-vista
# RF1_BOA_VISTA_URL_LOGIN=
# RF1_BOA_VISTA_URL_CONSULTA=
# RF1_BOA_VISTA_USUARIO=
# RF1_BOA_VISTA_SENHA=
# RF1_BOA_VISTA_CONSIGNATARIA=
# TWOCAPTCHA_API_KEY=
# HEADLESS=true

# GRID_CONVENIOS=roraima
# GRID_RORAIMA_URL_LOGIN=
# GRID_RORAIMA_URL_PERFIL=
# GRID_RORAIMA_USUARIO=
# GRID_RORAIMA_SENHA=
# GRID_RORAIMA_TIPO_PESSOA=4406
# GRID_RORAIMA_EMPRESA=7626
# GRID_RORAIMA_PERFIL=10443
# GRID_RORAIMA_LOGIN_TIMEOUT_MS=300000
# GRID_RORAIMA_BROWSER_CHANNEL=

# Comando executado pelo scheduler para cada prefeitura. Deixe vazio enquanto
# a credencial, URL ou base ainda não estiver disponível: o job ficará na fila.
# ROBOT_COMMAND_FORTALEZA="/root/ROBO_FACIL/env/bin/python main.py safeconsig fortaleza --file data/fortaleza.xlsx -y"
# ROBOT_COMMAND_MARANGUAPE="/root/ROBO_FACIL/env/bin/python main.py safeconsig maranguape --file data/maranguape.xlsx -y"

# Administração remota opcional (deploy.py e setup_cron.py --vps).
# Prefira uma chave SSH; não versione senhas ou chaves privadas.
MACHINE_SSH_HOST=
MACHINE_SSH_USER=
MACHINE_SSH_KEY_FILE=
# MACHINE_SSH_PASSWORD=
MACHINE_REMOTE_DIR=/root/ROBO_FACIL
