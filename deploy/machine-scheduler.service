[Unit]
Description=Machine worker pools
After=network-online.target machine-backend.service
Requires=machine-backend.service
Wants=machine-rf1-worker.service machine-facil-worker.service machine-safeconsig-worker.service machine-consiglog-worker.service
After=machine-rf1-worker.service machine-facil-worker.service machine-safeconsig-worker.service machine-consiglog-worker.service

[Service]
Type=oneshot
User=machine-worker
Group=machine-worker
ExecStart=/bin/true
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
